{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build"
  },
  "deploy": {
    "preDeployCommand": [
      "npm run predeploy"
    ],
    "startCommand": "node build/bin/server.js",
    "healthcheckPath": "/login",
    "restartPolicyType": "ON_FAILURE"
  }
}
